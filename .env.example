# Application
APP_ENV=development
APP_TIMEZONE=Europe/Moscow
APP_PORT=8080
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=15.0

# Public URL for inbound webhooks (KOMTET callback URL defaults to <PUBLIC_BASE_URL>/webhooks/komtet)
PUBLIC_BASE_URL=https://sync.example.com
KOMTET_CALLBACK_URL=

# Security (mandatory in production)
ADMIN_API_TOKEN=change_me_admin_token
RETAILCRM_WEBHOOK_TOKEN=change_me_webhook_token

# Database (SQLite async)
# Leave commented out to default to <repo>/data/integration.db
# DATABASE_URL=sqlite+aiosqlite:///./data/integration.db

# RetailCRM API v5
RETAILCRM_URL=https://your-shop.retailcrm.ru
RETAILCRM_API_KEY=your_retailcrm_api_key
RETAILCRM_DEFAULT_SITE=your-site

# KOMTET Kassa API
KOMTET_BASE_URL=https://kassa.komtet.ru
KOMTET_SHOP_ID=your_komtet_shop_id
KOMTET_SECRET_KEY=your_komtet_secret_key
KOMTET_QUEUE_ID=12345
KOMTET_API_VERSION=v2
