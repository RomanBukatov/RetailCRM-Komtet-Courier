# Application
APP_ENV=production
APP_TIMEZONE=Europe/Moscow
APP_PORT=8080
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
HTTP_TIMEOUT_SECONDS=15.0
# Optional explicit CORS origins (JSON array or comma-separated). Empty by default in production.
# CORS_ORIGINS=["https://sync.example.com"]

# Public URL for inbound webhooks (KOMTET callback URL defaults to <PUBLIC_BASE_URL>/webhooks/komtet)
PUBLIC_BASE_URL=https://sync.example.com
KOMTET_CALLBACK_URL=

# Security (mandatory in production — leave empty to fail closed until generated)
ADMIN_API_TOKEN=
RETAILCRM_WEBHOOK_TOKEN=

# Database (SQLite async)
# In Docker Compose defaults to sqlite+aiosqlite:////app/data/integration.db (named volume komtet_data)
# Leave commented out for local runs to default to <repo>/data/integration.db
# DATABASE_URL=sqlite+aiosqlite:///./data/integration.db

# RetailCRM API v5
RETAILCRM_URL=https://your-shop.retailcrm.ru
RETAILCRM_API_KEY=
RETAILCRM_DEFAULT_SITE=your-site

# KOMTET Kassa API
KOMTET_BASE_URL=https://kassa.komtet.ru
KOMTET_SHOP_ID=your_komtet_shop_id
KOMTET_SECRET_KEY=
KOMTET_QUEUE_ID=12345
KOMTET_API_VERSION=v2
